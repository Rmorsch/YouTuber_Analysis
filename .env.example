# YouTube Data API v3 - https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Snowflake -- if you don't have real credentials yet, fill these with any
# non-empty placeholder rather than leaving them blank. dbt's Snowflake
# adapter schema-validates the profile (rejecting an empty `user`, etc.)
# even for `dbt parse`, which never opens a connection -- an empty value
# fails that check and makes `dagster dev` refuse to load the code
# location entirely, whereas non-empty nonsense loads fine and only fails
# later, when something actually tries to connect.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=YOUTUBER_ANALYSIS

# Secondary destination write (TODO: not wired up yet - see
# youtuber_analysis/resources/postgres.py). Intended to be a Postgres
# instance running on the same droplet as Dagster.
POSTGRES_CONNECTION_STRING=

# Dagster -- must be an ABSOLUTE path (Dagster loads .env itself and
# rejects a relative value here even if your shell already exported one).
DAGSTER_HOME=/absolute/path/to/YouTuber_Analysis/.dagster_home
