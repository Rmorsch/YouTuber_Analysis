# Copy to dbt/profiles/profiles.yml (gitignored -- Dagster's DbtCliResource
# points profiles_dir here, see youtuber_analysis/assets/dbt_assets.py) and
# fill in the env vars in your shell / .env.
#
# Every env_var() below has a placeholder default so `dbt parse` (which
# only renders + validates this file, it doesn't open a connection) still
# succeeds before real Snowflake credentials exist. Anything that actually
# talks to the warehouse (`dbt run`, `dbt build`, ...) will fail against a
# placeholder value -- that's expected until real credentials are in .env.
youtuber_analysis:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT', 'unset') }}"
      user: "{{ env_var('SNOWFLAKE_USER', 'unset') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD', 'unset') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'TRANSFORMER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'unset') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'YOUTUBER_ANALYSIS') }}"
      schema: staging
      threads: 4
